# ─── Entorno ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Base de Datos (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgres://usuario:password@localhost:5432/archivistica_db

# ─── Supabase (opcional — alternativa a PostgreSQL directo) ───────
# Pide las credenciales reales a un miembro del equipo; nunca las hardcodees aquí.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=coloca_aqui_tu_anon_key
SUPABASE_SERVICE_KEY=coloca_aqui_tu_service_role_key

# ─── Autenticación JWT ────────────────────────────────────────────
# IMPORTANTE: El secreto debe tener al menos 32 caracteres.
JWT_SECRET=coloca_aqui_un_secreto_aleatorio_muy_largo_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h

# ─── CORS ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Storage (archivos digitalizados) ────────────────────────────
STORAGE_BUCKET=expedientes
STORAGE_PATH=./storage/uploads
